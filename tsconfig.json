{
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "es2023"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "erasableSyntaxOnly": true
  },
  "include": [
    "mox/**/*.ts",
    "extensions/**/*.ts",
    "evals/**/*.ts"
  ]
}
